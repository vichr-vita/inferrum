digraph inferrum {
  graph [rankdir=TB, bgcolor="#000000", pad=0.3];
  node [fontname="Helvetica", fontcolor="#ffffff", color="#aaaaaa", style=filled, fillcolor="#000000"];
  edge [color="#888888", fontcolor="#ffffff", fontname="Helvetica", fontsize=10];
  n0 [label="good_performance", tooltip="BR-01: Scores must be 0..100. A score above 50 passes.", shape=box];
  n1 [label="exceptional_performance", tooltip="BR-02: A score of at least 90 is exceptional.", shape=box];
  n2 [label="tenure_eligible", tooltip="BR-03: At least 12 months of service are required.", shape=box];
  n3 [label="conduct_clear", tooltip="BR-04: An active disciplinary hold blocks eligibility.", shape=box];
  n4 [label="employment_eligible", tooltip="BR-05: Employment must be active and tenure eligible.", shape=box];
  n5 [label="bonus_eligible", tooltip="BR-06: Require eligible employment, good performance, clear conduct, and completed training.", shape=box];
  n6 [label="role_rate", tooltip="BR-07: Base rates are 5% for clerks, 7% for specialists, and 8% for managers.", shape=box];
  n7 [label="department_factor", tooltip="BR-08: Department factors are 110% engineering, 120% sales, and 100% operations.", shape=box];
  n8 [label="company_factor", tooltip="BR-09: Company factor is 100% when its target is met, otherwise 50%.", shape=box];
  n9 [label="performance_factor", tooltip="BR-10: Exceptional performance multiplies the base by 150%, otherwise 100%.", shape=box];
  n10 [label="base_bonus", tooltip="BR-11: Multiply annual salary by the role rate.", shape=box];
  n11 [label="performance_bonus", tooltip="BR-12: Apply the performance factor to the base bonus.", shape=box];
  n12 [label="department_bonus", tooltip="BR-13: Apply the department factor after performance.", shape=box];
  n13 [label="company_bonus", tooltip="BR-14: Apply the company factor after the department factor.", shape=box];
  n14 [label="tenure_award", tooltip="BR-15: Add 50,000 cents for at least 36 months of service.", shape=box];
  n15 [label="retention_award", tooltip="BR-16: Add 75,000 cents for critical skills with good performance.", shape=box];
  n16 [label="proposed_bonus", tooltip="BR-17: Sum the company-adjusted bonus and both awards.", shape=box];
  n17 [label="eligible_bonus", tooltip="BR-18: Ineligible employees receive a zero proposed payment.", shape=box];
  n18 [label="capped_bonus", tooltip="BR-19: Cap the bonus at the employee-specific budget allocation.", shape=box];
  n19 [label="finance_required", tooltip="BR-20: Finance approval is required above 200,000 cents, strictly.", shape=box];
  n20 [label="approvals_satisfied", tooltip="BR-21: Require manager approval and finance approval when required.", shape=box];
  n21 [label="final_bonus", tooltip="BR-22: Emit the capped bonus if approvals pass, otherwise zero.", shape=box];
  n22 [label="payment_ready", tooltip="BR-23: Emit a payment-ready fact only for a positive final bonus.", shape=box];
  n23 [label="review_required", tooltip="BR-24: Emit approval_pending only for a positive bonus awaiting approval.", shape=box];
  n24 [label="total_compensation", tooltip="BR-25: Total compensation is annual salary plus the final bonus.", shape=box];
  n25 [label="payment_reference", tooltip="BR-26: Derive a reference from employee ID and payment cents only when payment is ready.", shape=box];
  n2 -> n4 [label="tenure_eligible"];
  n4 -> n5 [label="employment_eligible"];
  n0 -> n5 [label="good_performance"];
  n3 -> n5 [label="conduct_clear"];
  n1 -> n9 [label="exceptional_performance"];
  n6 -> n10 [label="role_rate_bps"];
  n10 -> n11 [label="base_bonus_cents"];
  n9 -> n11 [label="performance_factor_bps"];
  n11 -> n12 [label="performance_bonus_cents"];
  n7 -> n12 [label="department_factor_bps"];
  n12 -> n13 [label="department_bonus_cents"];
  n8 -> n13 [label="company_factor_bps"];
  n0 -> n15 [label="good_performance"];
  n13 -> n16 [label="company_bonus_cents"];
  n14 -> n16 [label="tenure_award_cents"];
  n15 -> n16 [label="retention_award_cents"];
  n5 -> n17 [label="bonus_eligible"];
  n16 -> n17 [label="proposed_bonus_cents"];
  n17 -> n18 [label="eligible_bonus_cents"];
  n18 -> n19 [label="capped_bonus_cents"];
  n19 -> n20 [label="finance_required"];
  n20 -> n21 [label="approvals_satisfied"];
  n18 -> n21 [label="capped_bonus_cents"];
  n21 -> n22 [label="final_bonus_cents"];
  n18 -> n23 [label="capped_bonus_cents"];
  n20 -> n23 [label="approvals_satisfied"];
  n21 -> n24 [label="final_bonus_cents"];
  n22 -> n25 [label="payment_ready_cents"];
}
