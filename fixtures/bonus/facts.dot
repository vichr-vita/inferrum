  n40 [label="good_performance", tooltip="BR-01: Scores must be 0..100. A score above 50 passes.", shape=box];
  n41 [label="exceptional_performance", tooltip="BR-02: A score of at least 90 is exceptional.", shape=box];
  n42 [label="tenure_eligible", tooltip="BR-03: At least 12 months of service are required.", shape=box];
  n43 [label="conduct_clear", tooltip="BR-04: An active disciplinary hold blocks eligibility.", shape=box];
  n44 [label="employment_eligible", tooltip="BR-05: Employment must be active and tenure eligible.", shape=box];
  n45 [label="bonus_eligible", tooltip="BR-06: Require eligible employment, good performance, clear conduct, and completed training.", shape=box];
  n46 [label="role_rate", tooltip="BR-07: Base rates are 5% for clerks, 7% for specialists, and 8% for managers.", shape=box];
  n47 [label="department_factor", tooltip="BR-08: Department factors are 110% engineering, 120% sales, and 100% operations.", shape=box];
  n48 [label="company_factor", tooltip="BR-09: Company factor is 100% when its target is met, otherwise 50%.", shape=box];
  n49 [label="performance_factor", tooltip="BR-10: Exceptional performance multiplies the base by 150%, otherwise 100%.", shape=box];
  n50 [label="base_bonus", tooltip="BR-11: Multiply annual salary by the role rate.", shape=box];
  n51 [label="performance_bonus", tooltip="BR-12: Apply the performance factor to the base bonus.", shape=box];
  n52 [label="department_bonus", tooltip="BR-13: Apply the department factor after performance.", shape=box];
  n53 [label="company_bonus", tooltip="BR-14: Apply the company factor after the department factor.", shape=box];
  n54 [label="tenure_award", tooltip="BR-15: Add 50,000 cents for at least 36 months of service.", shape=box];
  n55 [label="retention_award", tooltip="BR-16: Add 75,000 cents for critical skills with good performance.", shape=box];
  n56 [label="proposed_bonus", tooltip="BR-17: Sum the company-adjusted bonus and both awards.", shape=box];
  n57 [label="eligible_bonus", tooltip="BR-18: Ineligible employees receive a zero proposed payment.", shape=box];
  n58 [label="capped_bonus", tooltip="BR-19: Cap the bonus at the employee-specific budget allocation.", shape=box];
  n59 [label="finance_required", tooltip="BR-20: Finance approval is required above 200,000 cents, strictly.", shape=box];
  n60 [label="approvals_satisfied", tooltip="BR-21: Require manager approval and finance approval when required.", shape=box];
  n61 [label="final_bonus", tooltip="BR-22: Emit the capped bonus if approvals pass, otherwise zero.", shape=box];
  n62 [label="payment_ready", tooltip="BR-23: Emit a payment-ready fact only for a positive final bonus.", shape=box];
  n63 [label="review_required", tooltip="BR-24: Emit approval_pending only for a positive bonus awaiting approval.", shape=box];
  n64 [label="total_compensation", tooltip="BR-25: Total compensation is annual salary plus the final bonus.", shape=box];
  n65 [label="payment_reference", tooltip="BR-26: Derive a reference from employee ID and payment cents only when payment is ready.", shape=box];
