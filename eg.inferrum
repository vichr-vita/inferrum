
enum Role {
  clerk,
	manager,
}


fact Employee {
  age: int,
  role: Role,
	salary: int,
	department: string,
	boss: Optional<Employee>,
	performance: int
}


fact Out {
  mut bonus: int
}


predicate good_performance = Employee.performance > 50;

rule CalculateBonus "calculate bonus":
if good_performance {
  bonus = 100_000;
}
