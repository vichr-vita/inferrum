{
  "name": "inferrum-viewer",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build:viewer": "tsc -p viewer/tsconfig.json && node viewer/build.mjs",
    "check:viewer": "tsc -p viewer/tsconfig.json && node viewer/build.mjs --check",
    "preview": "cargo run --example bonus --features visualization && python3 -m http.server 4173 --bind 127.0.0.1 --directory target/bonus",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
